# DevHire Production Environment Variables
# Copy these or configure them in your Cloud Provider's Dashboard (Vercel, Render, Railway, Supabase, Neon)

# 1. Database Connection (Cloud PostgreSQL, e.g. Neon, Supabase, Render Postgres, Railway)
DATABASE_URL="postgresql://username:password@ep-sample-host.region.aws.neon.tech/devhire?sslmode=require"

# 2. Authentication Secrets (Generate a secure 32+ character random string)
JWT_SECRET="generate_a_secure_jwt_secret_for_production_use"
JWT_EXPIRES_IN="7d"

# 3. Live Application URL
NEXT_PUBLIC_APP_URL="https://your-devhire-deployment.vercel.app"

# 4. Optional Cloud AI Engine (Google Gemini API Key for AI Resume, Interview & Career Agent)
GEMINI_API_KEY="your_gemini_api_key_here"

# 5. Environment
NODE_ENV="production"
